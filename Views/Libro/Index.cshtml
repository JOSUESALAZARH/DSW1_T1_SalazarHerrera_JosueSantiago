@model IEnumerable<DSW1_T1_SalazarHerrera_JosueSantiago.Models.Libro>

@{
    ViewData["Title"] = "Listado de libros";
}

<h2>Listado de libros</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<p>
    <a asp-controller="Libro"
       asp-action="Crear"
       class="btn btn-primary">
        Registrar nuevo libro
    </a>
</p>

<form asp-controller="Libro" asp-action="Index" method="get"
      class="row g-3 mb-4">
    <div class="col-md-6">
        <label for="autor" class="form-label">Buscar por autor</label>
        <input type="text"
               id="autor"
               name="autor"
               value="@ViewBag.Autor"
               class="form-control"
               maxlength="100"
               placeholder="Ingrese el nombre del autor" />
    </div>

    <div class="col-md-6 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">
            Buscar
        </button>

        <a asp-controller="Libro"
           asp-action="Index"
           class="btn btn-secondary">
            Mostrar todos
        </a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre del libro</th>
            <th>Autor</th>
            <th>Editorial</th>
            <th>ISDN</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var libro in Model)
            {
                <tr>
                    <td>@libro.Id</td>
                    <td>@libro.NombreLibro</td>
                    <td>@libro.Autor</td>
                    <td>@libro.NombreEditorial</td>
                    <td>@libro.ISDN</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-controller="Libro"
                               asp-action="Editar"
                               asp-route-id="@libro.Id"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <form asp-controller="Libro"
                                  asp-action="Eliminar"
                                  asp-route-id="@libro.Id"
                                  method="post"
                                  onsubmit="return confirm('¿Está seguro de eliminar este libro?');">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Eliminar
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    No se encontraron libros.
                </td>
            </tr>
        }
    </tbody>
</table>